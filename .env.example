# Open WebUI Pure — example environment file.
#
# Copy to `.env` (source checkouts load it automatically) or pass the same
# variables through Podman / your process manager. Everything here is
# optional except a provider and, in production, WEBUI_SECRET_KEY.
#
# The default database is SQLite and no optional dependency is required.

# ─────────────────────────────────────────────────────────────────────────
# OpenAI-compatible provider
# ─────────────────────────────────────────────────────────────────────────
OPENAI_API_BASE_URL='https://api.openai.com/v1'
OPENAI_API_KEY=''

# Multiple OpenAI-compatible endpoints (semicolon-separated).
# OPENAI_API_BASE_URLS='https://api.openai.com/v1;http://192.168.1.10:8000/v1'
# OPENAI_API_KEYS='sk-...;sk-...'

# Image generation / editing use their own connection. Set these only when the
# environment should provide the default; the admin UI stores connections in
# the database instead.
# IMAGES_OPENAI_API_BASE_URL='https://api.openai.com/v1'
# IMAGES_OPENAI_API_KEY=''
# IMAGES_OPENAI_API_VERSION=''

# ─────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────
# Production deployments should pin a secret so sessions survive restarts.
# When unset, the start scripts generate one (start.sh writes it to
# WEBUI_SECRET_KEY_FILE, inside the data volume by default).
WEBUI_SECRET_KEY=''
# WEBUI_SECRET_KEY_FILE='.webui_secret_key'
# WEBUI_SECRET_KEY_LENGTH=24

# PORT=8080
# HOST=0.0.0.0
# FORWARDED_ALLOW_IPS='*'
# UVICORN_WORKERS=1
# ENV=prod
# GLOBAL_LOG_LEVEL=INFO
# LOG_FORMAT=json
# AUDIT_LOG_LEVEL=NONE

# Public URL, shown in share links and the PWA manifest.
# WEBUI_URL='https://chat.example.com'

# CORS is only needed when the frontend runs on another origin (for example
# `npm run dev` with the Vite proxy).
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'

# ─────────────────────────────────────────────────────────────────────────
# Accounts and authentication
# ─────────────────────────────────────────────────────────────────────────
# ENABLE_SIGNUP=True
# DEFAULT_USER_ROLE=pending
# ENABLE_LOGIN_FORM=True
# ENABLE_PASSWORD_AUTH=True
# WEBUI_AUTH=True

# First admin (used by the seeding flow when registration is disabled).
# WEBUI_ADMIN_EMAIL='admin@example.com'
# WEBUI_ADMIN_PASSWORD='change-me'
# WEBUI_ADMIN_NAME='Admin'

# Session cookie hardening (enable behind HTTPS).
# WEBUI_SESSION_COOKIE_SECURE=True
# WEBUI_AUTH_COOKIE_SECURE=True
# WEBUI_SESSION_COOKIE_SAME_SITE=lax

# ─────────────────────────────────────────────────────────────────────────
# SQLite (default database)
# ─────────────────────────────────────────────────────────────────────────
# DATABASE_URL='sqlite:////app/backend/data/webui.db'
# DATABASE_ENABLE_SQLITE_WAL=True
# Benchmarked personal-deployment defaults: 16 MiB page cache, 64 MiB mmap.
# Negative cache size is KiB (SQLite convention). Raise these only for large
# multi-user databases.
# DATABASE_SQLITE_PRAGMA_CACHE_SIZE=-16384
# DATABASE_SQLITE_PRAGMA_MMAP_SIZE=67108864
# DATABASE_SQLITE_PRAGMA_SYNCHRONOUS=NORMAL
# DATABASE_SQLITE_PRAGMA_BUSY_TIMEOUT=5000
# DATABASE_SQLITE_PRAGMA_TEMP_STORE=MEMORY
# DATABASE_SQLITE_PRAGMA_JOURNAL_SIZE_LIMIT=67108864

# ─────────────────────────────────────────────────────────────────────────
# PostgreSQL (optional; requires open-webui[postgres] / requirements-postgres)
# ─────────────────────────────────────────────────────────────────────────
# DATABASE_URL='postgresql+psycopg://user:password@localhost:5432/openwebui'
# Individual settings are also accepted:
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=openwebui
# DATABASE_USER=openwebui
# DATABASE_PASSWORD=change-me
# DATABASE_SCHEMA=public
# DATABASE_POOL_SIZE=10
# DATABASE_POOL_MAX_OVERFLOW=0
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=3600

# ─────────────────────────────────────────────────────────────────────────
# Redis (optional; only needed for multiple replicas)
# Requires open-webui[redis] / requirements-redis.
# ─────────────────────────────────────────────────────────────────────────
# REDIS_URL='redis://localhost:6379/0'
# WEBSOCKET_REDIS_URL='redis://localhost:6379/1'
# WEBSOCKET_MANAGER=redis
# ENABLE_WEBSOCKET_SUPPORT=True

# ─────────────────────────────────────────────────────────────────────────
# OAuth / OIDC (optional)
# ─────────────────────────────────────────────────────────────────────────
# ENABLE_OAUTH=True
# OAUTH_CLIENT_ID=''
# OAUTH_CLIENT_SECRET=''
# OPENID_PROVIDER_URL='https://accounts.example.com/.well-known/openid-configuration'
# OAUTH_PROVIDER_NAME='SSO'
# OAUTH_SCOPES='openid email profile'
# OAUTH_MERGE_ACCOUNTS_BY_EMAIL=True
# ENABLE_OAUTH_SIGNUP=False

# Provider shortcuts (Google / Microsoft Entra ID / GitHub / Feishu).
# GOOGLE_CLIENT_ID=''
# GOOGLE_CLIENT_SECRET=''
# MICROSOFT_CLIENT_ID=''
# MICROSOFT_CLIENT_SECRET=''
# MICROSOFT_CLIENT_TENANT_ID=''
# GITHUB_CLIENT_ID=''
# GITHUB_CLIENT_SECRET=''
# FEISHU_CLIENT_ID=''
# FEISHU_CLIENT_SECRET=''

# ─────────────────────────────────────────────────────────────────────────
# LDAP (optional; requires open-webui[ldap] / requirements-ldap)
# ─────────────────────────────────────────────────────────────────────────
# ENABLE_LDAP=True
# LDAP_SERVER_LABEL='LDAP'
# LDAP_SERVER_HOST='ldap.example.com'
# LDAP_SERVER_PORT=389
# LDAP_USE_TLS=True
# LDAP_ATTRIBUTE_FOR_USERNAME=uid
# LDAP_SEARCH_BASE='ou=users,dc=example,dc=com'
# LDAP_SEARCH_FILTER='(objectClass=person)'
# LDAP_APP_DN='cn=service,dc=example,dc=com'
# LDAP_APP_PASSWORD='change-me'

# ─────────────────────────────────────────────────────────────────────────
# Outbound proxy
# ─────────────────────────────────────────────────────────────────────────
# Passed through to the container by podman-compose. Use an address the
# container can reach; 127.0.0.1 is the container itself.
# HTTP_PROXY='http://host.containers.internal:3128'
# HTTPS_PROXY='http://host.containers.internal:3128'
# ALL_PROXY=''
# NO_PROXY='localhost,127.0.0.1'

# ─────────────────────────────────────────────────────────────────────────
# Outbound TLS / networking
# ─────────────────────────────────────────────────────────────────────────
# AIOHTTP_CLIENT_SESSION_SSL=True          # True | False | /path/to/ca-bundle.crt
# AIOHTTP_CLIENT_SSL_CERT_FILE=''          # CA bundle used when the above is True
# AIOHTTP_CLIENT_TIMEOUT=300
# AIOHTTP_CLIENT_ALLOW_REDIRECTS=False

# ─────────────────────────────────────────────────────────────────────────
# Maintenance / offline
# ─────────────────────────────────────────────────────────────────────────
# ENABLE_VERSION_UPDATE_CHECK=False
# OFFLINE_MODE=True
